  "editor.tokenColorCustomizations": {
    "comments": {
      "foreground": "#6c598c",
      "fontStyle": "italic"
    },
    "keywords": {
      "foreground": "#ff0055",
      "fontStyle": "bold"
    },
    "functions": {
      "foreground": "#00f0ff",
      "fontStyle": "bold"
    },
    "strings": {
      "foreground": "#00ff9f"
    },
    "numbers": {
      "foreground": "#ff7700"
    },
    "types": {
      "foreground": "#fcee0a",
      "fontStyle": "bold"
    },
    "variables": {
      "foreground": "#fcee0a"
    },
    "textMateRules": [
      {
        "name": "Keywords & Control Statements",
        "scope": [
          "keyword",
          "storage",
          "storage.type",
          "storage.modifier",
          "keyword.control"
        ],
        "settings": {
          "foreground": "#ff0055",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Functions & Methods (Electric Cyan)",
        "scope": [
          "entity.name.function",
          "meta.function-call",
          "support.function"
        ],
        "settings": {
          "foreground": "#00f0ff",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Variables & Parameters (Neon Yellow)",
        "scope": [
          "variable",
          "variable.parameter",
          "variable.other.readwrite"
        ],
        "settings": {
          "foreground": "#fcee0a"
        }
      },
      {
        "name": "Constants & Language Constants (Hot Pink)",
        "scope": [
          "constant",
          "constant.language",
          "support.constant",
          "variable.other.constant"
        ],
        "settings": {
          "foreground": "#ff2a85"
        }
      },
      {
        "name": "Strings & Literals (Matrix Acid Green)",
        "scope": [
          "string",
          "string.quoted",
          "string.template"
        ],
        "settings": {
          "foreground": "#00ff9f"
        }
      },
      {
        "name": "Template Literal Punctuation",
        "scope": [
          "punctuation.definition.template-expression"
        ],
        "settings": {
          "foreground": "#00f0ff"
        }
      },
      {
        "name": "Numbers & Booleans (Neon Orange)",
        "scope": [
          "constant.numeric",
          "constant.language.boolean"
        ],
        "settings": {
          "foreground": "#ff7700"
        }
      },
      {
        "name": "Object Keys & Properties (Neon Magenta)",
        "scope": [
          "meta.object-literal.key",
          "variable.object.property",
          "support.type.property-name"
        ],
        "settings": {
          "foreground": "#ff00a0"
        }
      },
      {
        "name": "Classes & Types (Neon Yellow)",
        "scope": [
          "entity.name.type",
          "entity.name.class",
          "support.class"
        ],
        "settings": {
          "foreground": "#fcee0a",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Operators & Punctuation (Cyber Cyan)",
        "scope": [
          "keyword.operator",
          "punctuation.separator",
          "punctuation.terminator"
        ],
        "settings": {
          "foreground": "#05d9e8"
        }
      },
      {
        "name": "JSON Keys",
        "scope": [
          "support.type.property-name.json"
        ],
        "settings": {
          "foreground": "#00f0ff"
        }
      },
      {
        "name": "JSON String Values",
        "scope": [
          "string.quoted.double.json"
        ],
        "settings": {
          "foreground": "#00ff9f"
        }
      },
      {
        "name": "RegExp",
        "scope": [
          "string.regexp"
        ],
        "settings": {
          "foreground": "#ff007f"
        }
      },
      {
        "name": "HTML & XML Tags",
        "scope": [
          "entity.name.tag"
        ],
        "settings": {
          "foreground": "#ff0055"
        }
      },
      {
        "name": "HTML & XML Attributes",
        "scope": [
          "entity.other.attribute-name"
        ],
        "settings": {
          "foreground": "#fcee0a"
        }
      },
      {
        "name": "CSS Classes & Properties",
        "scope": [
          "entity.other.attribute-name.class.css",
          "support.type.property-name.css"
        ],
        "settings": {
          "foreground": "#00f0ff"
        }
      }
    ]
  }
}
